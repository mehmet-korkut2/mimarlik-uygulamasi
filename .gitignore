# Python sanal ortamı (her bilgisayarda yeniden kurulur)
.venv/
# Deney ortamları (ör. .venv-deney: torch, Florence-2, PaddleOCR)
.venv-*/

# Python'un ürettiği geçici dosyalar
__pycache__/
*.pyc
.pytest_cache/

# Editör ve sistem dosyaları
.vscode/
.DS_Store
Thumbs.db

# Claude Code'un kişisel/yerel ayarları
.claude/settings.local.json

# Üretilen çıktılar (koddan tekrar üretilebilir)
output/

# Örnek el çizimleri (müşteri işi olabilir, GitHub'a gönderilmez)
ornekler/
# İnternetten bulunan krokiler (telif başkasının; kaynaklar.txt dahil yalnız yerelde). ornekler/ zaten
# kapsıyor; ornekler/ kuralı ileride daraltılırsa bile gitmesin diye ayrıca:
ornekler/internet/

# Deneylerin kontrol görselleri (fotoğrafın üstüne çizim = fotoğraf sayılır)
deneyler/**/gorseller/

# Claude masaüstü uygulamasının çıktı klasörü (mimar cevapları vb. özel belgeler)
Claude outputs/
