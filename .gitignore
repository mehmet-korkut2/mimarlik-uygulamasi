# Python sanal ortamı (her bilgisayarda yeniden kurulur)
.venv/

# Python'un ürettiği geçici dosyalar
__pycache__/
*.pyc
.pytest_cache/

# Editör ve sistem dosyaları
.vscode/
.DS_Store
Thumbs.db

# Claude Code'un kişisel/yerel ayarları
.claude/settings.local.json

# Üretilen çıktılar (koddan tekrar üretilebilir)
output/

# Örnek el çizimleri (müşteri işi olabilir, GitHub'a gönderilmez)
ornekler/

# Deneylerin kontrol görselleri (fotoğrafın üstüne çizim = fotoğraf sayılır)
deneyler/**/gorseller/
